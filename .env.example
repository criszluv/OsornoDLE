# Puerto del servidor
PORT=3000

# Fecha de inicio del juego (dia 1). Formato YYYY-MM-DD, hora de Chile.
GAME_EPOCH=2026-01-01

# Secreto para firmar los tokens de imagen del modo Locales.
# Cambialo en produccion por una cadena larga y aleatoria.
IMG_SECRET=cambia-esto-en-produccion

# Zona horaria usada para el cambio de dia
TZ_GAME=America/Santiago
